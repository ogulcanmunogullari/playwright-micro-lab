# ==============================================================================
# PLAYWRIGHT TEST ENVIRONMENT CONFIGURATION (.env)
# 
# Usage:
# 1. Copy this file and rename it to '.env'
# 2. Uncomment or set the STORAGE_STATE_PATH for the app you want to test.
# ==============================================================================

# --- SAUCEDEMO ---
# STORAGE_STATE_PATH=playwright/.auth/saucedemo-user.json
# SAUCEDEMO_BASE_URL=https://www.saucedemo.com

# --- HEROKUAPP ---
# STORAGE_STATE_PATH=playwright/.auth/herokuapp-user.json
# HEROKUAPP_BASE_URL=https://the-internet.herokuapp.com
